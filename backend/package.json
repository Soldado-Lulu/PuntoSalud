{
  "name": "medicamentos-offline-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "sequelize-cli db:migrate --config src/config/database.cjs --migrations-path src/migrations",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config src/config/database.cjs --migrations-path src/migrations",
    "db:seed": "node src/seeders/seed.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
